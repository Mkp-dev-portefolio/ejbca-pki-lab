# =============================================================================
# EJBCA PKI LAB — Environment Configuration
# Copy this file to .env and customize for each deployment
# =============================================================================

# -----------------------------------------------------------------------------
# DEPLOYMENT
# -----------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=ejbca-pki-lab
DEPLOY_ENV=dev          # dev | vps | prod

# -----------------------------------------------------------------------------
# PKI IDENTITY — Customize per client
# -----------------------------------------------------------------------------
PKI_ORGANIZATION="My Organization"
PKI_ORGANIZATION_UNIT="PKI Services"
PKI_COUNTRY="FR"
PKI_LOCALITY="Paris"
PKI_STATE="Ile-de-France"

# CA Names (used in Distinguished Names)
ROOT_CA_NAME="Root-CA"
POLICY_CA_NAME="Policy-CA"

# Issuing CAs — enabled/disabled per client
ISSUING_TLS_CA_ENABLED=true
ISSUING_TLS_CA_NAME="Issuing-TLS-CA"

ISSUING_IOT_CA_ENABLED=false
ISSUING_IOT_CA_NAME="Issuing-IoT-CA"

ISSUING_DEVOPS_CA_ENABLED=false
ISSUING_DEVOPS_CA_NAME="Issuing-DevOps-CA"

# -----------------------------------------------------------------------------
# EJBCA CONTAINER
# -----------------------------------------------------------------------------
EJBCA_IMAGE=keyfactor/ejbca-ce
EJBCA_VERSION=latest
EJBCA_HTTP_PORT=8080
EJBCA_HTTPS_PORT=8443
EJBCA_HTTPS_RA_PORT=8442
TLS_SETUP_ENABLED=true

# Log level: ERROR | WARN | INFO | DEBUG
LOG_LEVEL_APP=INFO
LOG_LEVEL_SERVER=WARN

# -----------------------------------------------------------------------------
# DATABASE (MariaDB)
# -----------------------------------------------------------------------------
DB_IMAGE=mariadb
DB_VERSION=10.11
DB_ROOT_PASSWORD=changeme_root_strong_password
DB_NAME=ejbca
DB_USER=ejbca
DB_PASSWORD=changeme_ejbca_strong_password
DB_PORT=3306

# -----------------------------------------------------------------------------
# NGINX REVERSE PROXY
# -----------------------------------------------------------------------------
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
# Your domain or IP — used in Nginx vhost
EJBCA_HOSTNAME=ejbca.lab.local
# Set to "true" to enable basic-auth on the Nginx proxy (extra layer)
NGINX_BASIC_AUTH=false

# -----------------------------------------------------------------------------
# VOLUMES & PERSISTENCE
# -----------------------------------------------------------------------------
DATA_DIR=./data
EJBCA_DATA_DIR=./data/ejbca
DB_DATA_DIR=./data/mariadb
BACKUP_DIR=./backups

# -----------------------------------------------------------------------------
# CLIENT SEGMENT PROFILE — used by init scripts
# Options: enterprise | iot | devops | all
# -----------------------------------------------------------------------------
CLIENT_PROFILE=enterprise

# -----------------------------------------------------------------------------
# ADVANCED — Certificate validity periods (days)
# -----------------------------------------------------------------------------
ROOT_CA_VALIDITY_DAYS=7300      # 20 years
POLICY_CA_VALIDITY_DAYS=3650    # 10 years
ISSUING_CA_VALIDITY_DAYS=1825   # 5 years
TLS_CERT_VALIDITY_DAYS=365      # 1 year
IOT_CERT_VALIDITY_DAYS=1825     # 5 years
DEVOPS_CERT_VALIDITY_DAYS=1     # 1 day (short-lived)
