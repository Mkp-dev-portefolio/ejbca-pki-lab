<?xml version="1.0" encoding="UTF-8"?>
<!--
  Certificate Profile: IoT Device Identity
  Purpose:     Device identity for IoT onboarding (EST, CMP, SCEP)
  Validity:    5 years (1825 days)
  Key usage:   digitalSignature, keyEncipherment
  EKU:         clientAuth — device presents cert to authenticate to platform
  SAN:         URI (device ID: urn:device:SERIALNUMBER) or DNS
  Notes:
    - Serial number in Subject CN carries device serial
    - OU carries device class / product line
    - Use RSA-2048 or EC P-256 for constrained devices
-->
<certificateprofile>
  <version>46</version>
  <type>1</type>

  <validity>1825d</validity>

  <availablekeyalgorithms>
    <string>RSA</string>
    <string>ECDSA</string>
  </availablekeyalgorithms>
  <availablebitlengths>
    <int>2048</int>
    <int>256</int>
    <int>384</int>
  </availablebitlengths>
  <minimumavailablebitlength>2048</minimumavailablebitlength>

  <usekeyusage>true</usekeyusage>
  <keyusage>
    <bool>true</bool>   <!-- digitalSignature -->
    <bool>false</bool>
    <bool>true</bool>   <!-- keyEncipherment -->
    <bool>false</bool>
    <bool>false</bool>
    <bool>false</bool>
    <bool>false</bool>
    <bool>false</bool>
    <bool>false</bool>
  </keyusage>
  <keyusageiscritical>true</keyusageiscritical>

  <useextendedkeyusage>true</useextendedkeyusage>
  <extendedkeyusage>
    <string>1.3.6.1.5.5.7.3.2</string>   <!-- clientAuth -->
  </extendedkeyusage>
  <extendedkeyusageiscritical>false</extendedkeyusageiscritical>

  <!-- URI SAN for device URN -->
  <usesubjectalternativename>true</usesubjectalternativename>
  <subjectaltnamescritical>false</subjectaltnamescritical>

  <!-- Subject DN — device serial in CN -->
  <!-- CN=<DeviceSerial>, OU=<ProductLine>, O=<OrgName>, C=FR -->

  <usecrldistributionpoint>true</usecrldistributionpoint>
  <usedefaultcrldistributionpoint>true</usedefaultcrldistributionpoint>
  <useauthorityinformationaccess>true</useauthorityinformationaccess>
  <usedefaultocspservicelocator>true</usedefaultocspservicelocator>
  <useauthoritykeyidentifier>true</useauthoritykeyidentifier>
  <usesubjectkeyidentifier>true</usesubjectkeyidentifier>
  <usebasicconstraints>true</usebasicconstraints>
  <basicconstraintscritical>true</basicconstraintscritical>

  <!-- Allow renewal — devices may need cert renewal via EST Re-enroll -->
  <allowcertificateserialnoissuedrenewal>true</allowcertificateserialnoissuedrenewal>

  <availablecas>
    <int>-1</int>
  </availablecas>

  <description>IoT Device Identity Certificate — 5 year validity, clientAuth, EST/CMP enrollment</description>
</certificateprofile>
